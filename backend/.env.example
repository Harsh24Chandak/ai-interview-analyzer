# AI Interview Analyzer — Backend Environment Configuration
# Copy this file to .env and fill in your values

# Google Gemini API Key (Get one at https://aistudio.google.com/app/apikey)
# If omitted or empty, the backend automatically runs in transparent Intelligent Demo/Fallback Mode.
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Security & JWT Configuration
SECRET_KEY=super-secret-jwt-signing-key-change-in-production-2026
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration (SQLite default; supports PostgreSQL e.g. postgresql://user:pass@localhost:5432/interview_db)
DATABASE_URL=sqlite:///./ai_interview_analyzer.db

# Server & CORS Settings
PORT=5000
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173
MAX_UPLOAD_SIZE_MB=10
